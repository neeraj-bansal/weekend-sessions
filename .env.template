# --- Groq (used as OpenAI-compatible endpoint) --------------------------------
OPENAI_API_KEY=                        # https://console.groq.com/keys
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# --- Ollama -------------------------------------------------------------------
OLLAMA_MODEL=gemma3:270m

# --- LangSmith ----------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=                     # https://smith.langchain.com
LANGSMITH_PROJECT=section-02-first-agent

# --- Tavily (web search) — day1/section2 scripts 02-04 -----------------------
TAVILY_API_KEY=                        # https://app.tavily.com

# --- AWS (Bedrock + AgentCore) ------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2

# --- Alpha Vantage (day1/section-04 market data) -----------------------------
ALPHA_VANTAGE_API_KEY=                 # https://www.alphavantage.co/support/#api-key
