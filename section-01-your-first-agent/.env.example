# =============================================================================
#  Section 1 — Your First AI Agent
#  Copy this file and rename the copy to .env
#    Mac/Linux:  cp .env.example .env
#  Never commit .env — it holds your secret keys.
# =============================================================================

# -----------------------------------------------------------------------------
#  OPTION A — Groq (free tier, recommended for this course)
#  Get a key: https://console.groq.com/keys
#  Groq speaks the OpenAI API — no code change needed vs real OpenAI.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=gsk_paste-your-groq-key-here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# Groq model for Strands notebooks (_groq variants)
GROQ_API_KEY=gsk_paste-your-groq-key-here
# GROQ_MODEL_ID=openai/gpt-oss-20b   # override default

# -----------------------------------------------------------------------------
#  OPTION B — Real OpenAI (paid)
#  Get a key: https://platform.openai.com/api-keys
#  Comment out OPENAI_BASE_URL and OPENAI_MODEL above, then set:
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-paste-your-openai-key-here
# OPENAI_MODEL=gpt-5.6-sol

# -----------------------------------------------------------------------------
#  LOCAL MODEL — Ollama (script 03 and "04 --local", no key needed)
# -----------------------------------------------------------------------------
OLLAMA_MODEL=gemma3:270m

# -----------------------------------------------------------------------------
#  AWS — Bedrock + AgentCore (notebooks 01_hello_agent.ipynb, aws_strands/)
#  Credentials are read from ~/.aws/credentials automatically by boto3.
#  Only set these if you want to override the default profile.
# -----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2

# -----------------------------------------------------------------------------
#  OPTIONAL — LangSmith tracing (see every call at smith.langchain.com)
# -----------------------------------------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_paste-your-langsmith-key-here
# LANGSMITH_PROJECT=section-01-your-first-agent
